{
  "name": "career-roadmap-be",
  "version": "1.0.0",
  "description": "Backend scaffold for Personalized Career Orientation & Learning Roadmap Platform for Software Engineering Students",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node scripts/startProduction.js",
    "start:production": "node scripts/startProduction.js",
    "start:node": "node server.js",
    "docker:up": "docker compose up -d && node scripts/print-docker-help.js",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api",
    "docker:restart": "docker compose down && docker compose up -d && node scripts/print-docker-help.js",
    "docker:help": "node scripts/print-docker-help.js",
    "fix:learning-indexes": "node scripts/fixLearningContentIndexes.js",
    "test:skill-vector": "node scripts/testSkillVectorBuilder.js",
    "test:skill-insights": "node scripts/testSkillInsights.js",
    "test:snapshot-vector": "node scripts/testSnapshotVectorMapper.js",
    "test:skill-vector-compare": "node scripts/testSkillVectorComparison.js",
    "test:role-matching": "node scripts/testRoleMatching.js",
    "test:roadmap-skill-gap": "node scripts/testRoadmapSkillGap.js",
    "test:learning-canonicalization": "node scripts/testLearningCanonicalization.js",
    "test:end-to-end-flow": "node scripts/testEndToEndFlowConsistency.js",
    "test:current-context": "node scripts/testCurrentContextServiceHarness.js",
    "test:github-account": "node scripts/testGithubAccountFlow.js",
    "test:dev2vec-input": "node scripts/testDev2VecInputBuilder.js",
    "test:dev2vec-evidence-taxonomy": "node scripts/testDev2VecEvidenceTaxonomy.js",
    "test:backend-analysis-pipeline": "node scripts/testBackendAnalysisPipelineFixes.js",
    "test:analysis-performance": "node scripts/testAnalysisPerformanceOptimizations.js",
    "test:soft-delete-close-policies": "node scripts/testSoftDeleteClosePolicies.js",
    "test:chat-context-pinning": "node scripts/testChatContextPinning.js",
    "test:chat-mentor-context": "node scripts/testChatMentorContext.js",
    "benchmark:analysis-performance": "node scripts/benchmarkAnalysisPerformanceOptimizations.js",
    "migrate:analysis-performance-indexes": "node scripts/createAnalysisPerformanceIndexes.js"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
