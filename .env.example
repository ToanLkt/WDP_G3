NODE_ENV=production
PORT=5000

MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority&appName=<app-name>
# Optional backward compatibility:
MONGODB_URI=

JWT_SECRET=your_jwt_secret
GOOGLE_CLIENT_ID=970437677508-k1jc855q10hnl3sktcop9job68hgkd0r.apps.googleusercontent.com
JWT_EXPIRES_IN=7d

GITHUB_API_BASE_URL=https://api.github.com
GITHUB_TOKEN=

# Single GitHub OAuth App credentials used for both login and repository connect.
GITHUB_CLIENT_ID=change_me
GITHUB_CLIENT_SECRET=change_me

# Single GitHub OAuth callback. Configure this exact URL in your GitHub OAuth App.
# This callback dispatches both login state and repository-connect state.
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# Web callback that receives GitHub login result.
GITHUB_AUTH_REDIRECT_URL=http://localhost:5173/auth/github/callback

# Mobile deep link that receives GitHub login result.
# Mobile clients should call POST /api/auth/github with:
# { "redirectUrl": "gitanalyzer://auth/github/callback" }
MOBILE_AUTH_REDIRECT_URL=gitanalyzer://auth/github/callback

FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:3000
FRONTEND_URLS=https://web-project-seven-rust.vercel.app,http://localhost:5173

# Mobile deep link for connecting GitHub repositories after login.
MOBILE_REDIRECT_URL=gitanalyzer://github/connect

# Production example:
# GITHUB_CALLBACK_URL=https://career-roadmap-api-zs7y.onrender.com/api/auth/github/callback
# GITHUB_AUTH_REDIRECT_URL=https://web-project-seven-rust.vercel.app/auth/github/callback
# MOBILE_AUTH_REDIRECT_URL=gitanalyzer://auth/github/callback
# FRONTEND_URL=https://web-project-seven-rust.vercel.app
# CLIENT_URL=https://web-project-seven-rust.vercel.app
# FRONTEND_URLS=https://web-project-seven-rust.vercel.app,http://localhost:5173
# MOBILE_REDIRECT_URL=gitanalyzer://github/connect

LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key
LLM_MODEL=gemini-3.6-flash
# Comma-separated models tried only when the primary model is unavailable/unsupported.
LLM_FALLBACK_MODELS=gemini-flash-latest
# Model names must not include the "models/" prefix.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
YOUTUBE_API_KEY=your_youtube_api_key_here

DEV2VEC_ENABLED=true
# Local process fallback uses `python`; container production overrides this with /opt/venv/bin/python.
DEV2VEC_PYTHON_BIN=python
DEV2VEC_INFER_PATH=ml_service/infer.py
DEV2VEC_TIMEOUT_MS=30000
# Bounded local subprocess timeout. Falls back to DEV2VEC_TIMEOUT_MS for compatibility.
DEV2VEC_PROCESS_TIMEOUT_MS=60000
DEV2VEC_MAX_BUFFER_BYTES=10485760
DEV2VEC_ARTIFACTS_DIR=ml_service/artifacts
# Persistent HTTP worker mode (recommended in production). Leave blank for process-only local mode.
DEV2VEC_SERVICE_URL=
DEV2VEC_SERVICE_HOST=127.0.0.1
DEV2VEC_SERVICE_PORT=8001
DEV2VEC_SERVICE_TIMEOUT_MS=30000
DEV2VEC_SERVICE_FALLBACK_ENABLED=true
DEV2VEC_SERVICE_CONCURRENCY=1
DEV2VEC_SERVICE_MAX_BODY_BYTES=10485760
# Backward-compatible default stores vectors in live analysis records; snapshots omit them.
DEV2VEC_PERSIST_VECTORS=true
# Structured redacted inference events are opt-in; debug flags should remain false in production.
DEV2VEC_OBSERVABILITY_LOG=false

API_BASE_URL=http://localhost:5000
# Production example:
# API_BASE_URL=https://career-roadmap-api-zs7y.onrender.com
